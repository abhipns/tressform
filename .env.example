# Tressform — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values — this file only documents which keys the app expects.
#
# IMPORTANT: every integration below runs in MOCK MODE automatically when its
# keys are missing (see lib/integrations/*.ts) — the app is fully runnable and
# testable with this file left blank. Fill in real values as accounts are set up.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AWS Rekognition (IAM user scoped to rekognition:DetectFaces only)
# Namespaced (not the bare AWS_* names) so this app's mock-mode detection
# never collides with AWS credentials some hosting environments inject for
# unrelated infrastructure.
REKOGNITION_AWS_ACCESS_KEY_ID=
REKOGNITION_AWS_SECRET_ACCESS_KEY=
REKOGNITION_AWS_REGION=ap-south-1

# FAL AI (hairstyle image generation — PuLID Flux recommended, see Part H)
FAL_AI_API_KEY=

# Razorpay (checkout for Starter Pack / Style Pack / Complete Pack / Full Explore, ₹ INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# EarnKaro (affiliate link conversion — see Part J implementation note:
# no catalog API, links are generated manually per product)
EARNKARO_ACCOUNT_EMAIL=

# MSG91 (email + WhatsApp Business API for Trivia/blog notifications)
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=

# Admin carousel-photo upload (app/admin/carousel, app/api/admin/carousel) —
# a placeholder shared-secret gate until real profiles.role='ADMIN' auth
# exists. Pick any long random string; enter the same value on the page.
ADMIN_UPLOAD_KEY=
